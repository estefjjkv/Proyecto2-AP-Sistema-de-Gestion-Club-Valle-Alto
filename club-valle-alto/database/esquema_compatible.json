  "constraints": [
    [
      "administrador",
      "administrador_codigo_rol_fkey",
      "FOREIGN KEY (codigo_rol) REFERENCES cat_rol_admin(codigo)"
    ],
    [
      "administrador",
      "administrador_intentos_fallidos_check",
      "CHECK ((intentos_fallidos >= 0))"
    ],
    [
      "administrador",
      "administrador_pkey",
      "PRIMARY KEY (cedula)"
    ],
    [
      "beneficiario",
      "beneficiario_cedula_titular_fkey",
      "FOREIGN KEY (cedula_titular) REFERENCES membresia(cedula_socio) ON DELETE CASCADE"
    ],
    [
      "beneficiario",
      "beneficiario_check",
      "CHECK (((cedula_titular)::text <> (cedula_beneficiario)::text))"
    ],
    [
      "beneficiario",
      "beneficiario_codigo_parentesco_fkey",
      "FOREIGN KEY (codigo_parentesco) REFERENCES cat_parentesco(codigo)"
    ],
    [
      "beneficiario",
      "beneficiario_fecha_nacimiento_check",
      "CHECK ((fecha_nacimiento < CURRENT_DATE))"
    ],
    [
      "beneficiario",
      "beneficiario_pkey",
      "PRIMARY KEY (cedula_titular, cedula_beneficiario)"
    ],
    [
      "bloqueo_instalacion",
      "bloqueo_instalacion_cedula_admin_fkey",
      "FOREIGN KEY (cedula_admin) REFERENCES administrador(cedula)"
    ],
    [
      "bloqueo_instalacion",
      "bloqueo_instalacion_check",
      "CHECK ((fin > inicio))"
    ],
    [
      "bloqueo_instalacion",
      "bloqueo_instalacion_codigo_instalacion_fkey",
      "FOREIGN KEY (codigo_instalacion) REFERENCES instalacion(codigo)"
    ],
    [
      "bloqueo_instalacion",
      "bloqueo_instalacion_codigo_instalacion_tsrange_excl",
      "EXCLUDE USING gist (codigo_instalacion WITH =, tsrange(inicio, fin) WITH &&)"
    ],
    [
      "bloqueo_instalacion",
      "bloqueo_instalacion_codigo_motivo_fkey",
      "FOREIGN KEY (codigo_motivo) REFERENCES cat_motivo_bloqueo(codigo)"
    ],
    [
      "bloqueo_instalacion",
      "bloqueo_instalacion_pkey",
      "PRIMARY KEY (id_bloqueo)"
    ],
    [
      "cargo",
      "cargo_cedula_admin_pago_fkey",
      "FOREIGN KEY (cedula_admin_pago) REFERENCES administrador(cedula)"
