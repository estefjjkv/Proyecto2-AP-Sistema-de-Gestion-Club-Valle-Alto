# Copie este archivo a .env. .env nunca se sube a GitHub.
# Opción A: cadena PostgreSQL entregada por su compañero/proveedor.
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/BASE?sslmode=require
DATABASE_URL=

# Opción B: datos separados (solo se usan si DATABASE_URL está vacía).
DB_NAME=club_valle_alto
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=prefer

DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Obligatorio al publicar con DJANGO_DEBUG=0; genere su propio secreto.
# DJANGO_SECRET_KEY=
SITE_URL=http://127.0.0.1:8000

# Desarrollo: muestra el enlace de recuperación en la terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Club Valle Alto <no-reply@example.com>
# Para envío real, use SMTP y los datos de su proveedor:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
